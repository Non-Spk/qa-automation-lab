{
  "name": "qa-automation-lab",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "i18n:check": "tsx src/resources/translations/script/check-i18n.ts",
    "docker:test": "docker build -t qa-automation-lab . && docker run --rm qa-automation-lab",
    "act:push": "act push -W .github/workflows/playwright.yml",
    "act:pr": "act pull_request -W .github/workflows/playwright.yml",
    "act:workflow": "act workflow_dispatch -W .github/workflows/playwright.yml",
    "jenkins:build": "docker compose up --build -d",
    "jenkins:password": "docker logs jenkins"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
